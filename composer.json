{
  "name": "neuron-php/labor-board",
  "description": "Job queue dashboard for Neuron MVC and CMS applications: pending, delayed, reserved and failed jobs, retry, delete, dispatch.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Lee Jones",
      "email": "lee@dragonflyrg.com"
    }
  ],
  "require": {
    "php": ">=8.4",
    "ext-json": "*",
    "neuron-php/mvc": ">=0.9.58 <0.10",
    "neuron-php/jobs": ">=0.2.24 <0.3"
  },
  "require-dev": {
    "phpunit/phpunit": "9.*"
  },
  "autoload": {
    "files": [
      "src/LaborBoard/View/helpers.php"
    ],
    "psr-4": {
      "Neuron\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "neuron": {
      "mvc-provider": "Neuron\\LaborBoard\\Provider"
    }
  }
}
